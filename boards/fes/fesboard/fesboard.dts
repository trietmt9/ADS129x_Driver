/*
 * FES Board — STM32F767ZITx biopotential sensing board
 *
 * Wearable 8-channel biopotential AFE (ADS1298) + STM32F767 + Wi-Fi/BLE
 * (WT02C40C) + IMU (ICM-42688-P). Pin assignments extracted from the KiCad
 * schematic (U6 = STM32F767ZITx) and cross-checked in ADS1298_STM32_pinout.md.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;
#include <st/f7/stm32f767Xi.dtsi>
#include <st/f7/stm32f767zitx-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	model = "FES Board STM32F767ZI";
	compatible = "fes,fesboard";

	chosen {
		/*
		 * USART2 (PA2/PA3) is the link to the WT02C40C module. It also
		 * serves as the bring-up console — attach a 3V3 USB-UART to
		 * PA2(TX)/PA3(RX) while the nRF module is unpopulated. Move the
		 * console to USB-CDC or SEGGER RTT once those are up.
		 */
		zephyr,console = &usart2;
		zephyr,shell-uart = &usart2;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,dtcm = &dtcm;
	};

	aliases {
		ads1298-spi = &spi1;
		imu-spi = &spi2;
		nrf-uart = &usart2;
	};

	/*
	 * ADS1298 discrete control lines that are not part of the SPI bus.
	 * Kept as a gpio container so the existing driver can fetch them by
	 * node label via GPIO_DT_SPEC_GET(DT_NODELABEL(ads129x_*), gpios).
	 * (A cleaner refactor is to move these onto the ads129x SPI node as
	 *  reset-gpios/drdy-gpios/... properties — see notes in the docs.)
	 */
	ads1298_ctrl: ads1298-ctrl {
		compatible = "gpio-keys";

		ads129x_cs: ads129x_cs {
			gpios = <&gpioa 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PA4 -> ADS pin 39 CS (manual) */
			label = "ADS1298 CS";
		};
		ads129x_reset: ads129x_reset {
			gpios = <&gpiob 0 GPIO_ACTIVE_LOW>;   /* PB0  -> ADS pin 36 RESET  */
			label = "ADS1298 RESET";
		};
		ads129x_pwdn: ads129x_pwdn {
			gpios = <&gpioc 5 GPIO_ACTIVE_LOW>;   /* PC5  -> ADS pin 35 PWDN   */
			label = "ADS1298 PWDN";
		};
		ads129x_start: ads129x_start {
			gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;  /* PB1  -> ADS pin 38 START  */
			label = "ADS1298 START";
		};
		ads129x_drdy: ads129x_drdy {
			gpios = <&gpioc 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PC4 -> ADS pin 47 DRDY */
			label = "ADS1298 DRDY";
		};
	};
};

/* ---------------------------------------------------------------------------
 * Clocks — real 8 MHz HSE crystal (Y1). Unlike the Nucleo, this is a genuine
 * crystal, so DO NOT set hse-bypass. PLL -> 216 MHz SYSCLK, 48 MHz for USB
 * (VCO 432 MHz / Q=9 = 48 MHz).
 * -------------------------------------------------------------------------*/
&clk_hse {
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

&clk_lsi {
	status = "okay";
};

&pll {
	div-m = <4>;
	mul-n = <216>;
	div-p = <2>;
	div-q = <9>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(216)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <4>;
	apb2-prescaler = <2>;
};

/* ---------------------------------------------------------------------------
 * USART2 — WT02C40C (nRF5340) link + bring-up console. PA2 TX / PA3 RX.
 * -------------------------------------------------------------------------*/
&usart2 {
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <921600>;   /* 4 ch x 1000 SPS needs > 12 kB/s */
	status = "okay";
};

/* ---------------------------------------------------------------------------
 * SPI1 — ADS1298 8-channel biopotential AFE (U2).
 *   PA5 SCK / PA6 MISO / PA7 MOSI, PA4 CS (manual GPIO), mode 1.
 * -------------------------------------------------------------------------*/
&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	/*
	 * No cs-gpios here on purpose: the ADS1298 driver toggles CS manually
	 * (see spi_cs_control) via the ads129x_cs node = PA4. Adding cs-gpios
	 * would make Zephyr auto-drive PA4 too and fight the driver.
	 */
	status = "okay";

	ads129x: ads129x@0 {
		compatible = "vnd,spi-device";      /* placeholder: hand-rolled driver, no binding yet */
		reg = <0>;
		spi-max-frequency = <2000000>;      /* 2 MHz for bring-up; ADS1298 allows up to 20 MHz */
		spi-cpha;                           /* SPI mode 1: CPOL=0, CPHA=1 (do NOT add spi-cpol) */
		spi-interframe-delay-ns = <0>;
	};
};

/* ---------------------------------------------------------------------------
 * SPI2 — ICM-42688-P 6-axis IMU (U5).
 *   PB13 SCK / PB14 MISO / PB15 MOSI, PD8 CS, PB12 INT1, PD9 INT2.
 * -------------------------------------------------------------------------*/
&spi2 {
	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pb14 &spi2_mosi_pb15>;
	pinctrl-names = "default";
	cs-gpios = <&gpiod 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  /* PD8 -> IMU CS */
	status = "okay";

	icm42688: icm42688@0 {
		compatible = "invensense,icm42688";
		reg = <0>;
		spi-max-frequency = <8000000>;      /* 24 MHz max; 8 MHz safe for bring-up */
		int-gpios = <&gpiob 12 GPIO_ACTIVE_HIGH>; /* PB12 INT1 */
		/* PD9 (INT2) available as a second interrupt if needed */
		status = "disabled";                /* enable once IMU firmware/CONFIG_ICM42688 is added */
	};
};

/* ---------------------------------------------------------------------------
 * USB OTG FS — USB-C data (PA11 D-, PA12 D+). PA9 is VBUS sense.
 * -------------------------------------------------------------------------*/
zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};

/*
 * SWD (PA13 SWDIO / PA14 SWCLK) is enabled by default on STM32; no DT node
 * needed. Programmed via J1 (TC2030-NL) with the runners in board.cmake.
 */
